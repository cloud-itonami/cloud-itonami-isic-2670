{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj). This
 ;; repo is standalone (forkable outside the workspace); the :local/root
 ;; paths only resolve inside the monorepo checkout — a standalone fork
 ;; should override them with git coordinates.
 :deps {
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "325baa31020aa214bd17cb39e3803712f92f5a1a"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "325baa31020aa214bd17cb39e3803712f92f5a1a"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "325baa31020aa214bd17cb39e3803712f92f5a1a"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "325baa31020aa214bd17cb39e3803712f92f5a1a"
         :deps/root "lib/kotoba.text"}
       ;; デジタル庁デザインシステム (DADS) -- the workspace-wide base design
        ;; system (root AGENTS.md "UI/UX 標準"). Used ONLY by the
        ;; build-time `opticsworks.render-html` generator to style
        ;; `docs/samples/operator-console.html`; the actor/governor/store
        ;; path never touches it. Pinned git coordinate (not :local/root)
        ;; so this repo stays forkable standalone outside the monorepo.
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "325baa31020aa214bd17cb39e3803712f92f5a1a"
         :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}
        io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.langgraph"}
        io.github.kotoba-lang/robotics
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.robotics"}
        ;; REAL engineering-simulation dependency (ADR-2607151600/
        ;; ADR-2607152000's real-physics fleet pattern, delivered NATIVELY
        ;; from day one -- mirroring cloud-itonami-isic-2220/-2630/-2920/
        ;; -2720/-2310's own native builds rather than a retrofit):
        ;; opticsworks.robotics actually calls physics-2d/world-step -- a
        ;; real, tested time-stepped rigid-body impulse solver -- to run a
        ;; real lens-barrel press-fit seating-test simulation (a moving
        ;; seating-press tool vs. a static lens-housing seating register),
        ;; instead of comparing static self-reported fields. This vertical
        ;; has no design-library sibling repo, so the physics module is
        ;; built directly in opticsworks.robotics and the ONLY new
        ;; dependency is physics-2d itself, taken as a real pinned
        ;; git-coordinate dep (not :local/root) so this repo stays
        ;; forkable standalone outside the monorepo.
        io.github.kotoba-lang/physics-2d
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "325baa31020aa214bd17cb39e3803712f92f5a1a"
         :deps/root "lib/kotoba.physics2d"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; kbb -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "opticsworks.sim"]}
  ;; kbb -M:dev:physics -> the physical-AI bot's measurement (hermes/profiles/physai-isic-2670/SOUL.md):
  ;; one EDN map of the quantities the REAL physics-2d simulation computed. Exit 2 = could not measure.
  :physics {:main-opts ["-m" "opticsworks.physics-probe"]}
  :export {:main-opts ["-m" "opticsworks.export-run"]}
  :render-export {:main-opts ["-m" "opticsworks.render-export"]}
  ;; kbb -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html by actually running the actor
  ;; (flagship checklist item 2). Refuses to write when the run produced
  ;; no HARD governor hold -- see `opticsworks.render-html/-main`.
  :render-html {:main-opts ["-m" "opticsworks.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
