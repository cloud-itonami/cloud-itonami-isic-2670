(ns opticsworks.physics-probe
  "The physical-AI bot's measurement: run this actor's REAL `physics-2d`
  lens-barrel press-fit seating simulation
  (`opticsworks.robotics/simulate-lens-seating`) over a fixed sweep and
  print ONE EDN map of the physical quantities it computed.

    kbb -M:dev:physics

  This is what the resident bot (hermes/profiles/physai-isic-2670/SOUL.md)
  reads every tick. Every number is derived from a time-stepped
  trajectory, never typed in. Output schema `itonami.physical-ai.probe.v1`
  (see cloud-itonami-isic-2013's probe for the shared contract).

  `:count` is an evidence floor: the bot treats 0 as \"could not
  measure\", never as \"nothing out of tolerance\". Exit 0 when every run
  produced numbers, 2 when any run did not."
  (:require [opticsworks.robotics :as robotics]))

(def schema "itonami.physical-ai.probe.v1")

(def sweep
  "Seating configurations swept each tick: the store batches' own
  recorded seating-press effective masses (0.005 / 0.025 kg consumer
  grade, 0.4 / 1.0 kg ruggedized grade) plus 0.1 and 2.0 kg to bracket
  the ruggedized band."
  [{:mass-kg 0.005 :product-class :consumer-grade}
   {:mass-kg 0.025 :product-class :consumer-grade}
   {:mass-kg 0.1   :product-class :consumer-grade}
   {:mass-kg 0.4   :product-class :ruggedized-grade}
   {:mass-kg 1.0   :product-class :ruggedized-grade}
   {:mass-kg 2.0   :product-class :ruggedized-grade}])

(defn- run-one [{:keys [mass-kg product-class] :as input}]
  (let [{:keys [min max]} (robotics/seating-force-band-for product-class)
        t (robotics/seating-telemetry-for {:seating-press-effective-mass-kg mass-kg})]
    {:input input
     :quantities (assoc t :peak-decel-mps2 (/ (:sim-peak-seating-force-n t) mass-kg))
     :out-of-tolerance? (boolean (robotics/lens-seating-force-out-of-tolerance?
                                  (assoc t :seating-force-min-n min :seating-force-max-n max)))}))

(defn- force-at [mass-kg]
  (:sim-peak-seating-force-n (robotics/seating-telemetry-for {:seating-press-effective-mass-kg mass-kg})))

(defn mass-at-force-kg
  "Smallest seating-press effective mass whose simulated peak seating
  force reaches `force-n`, by bisection over the REAL simulation (force
  is monotone in mass -- pinned by the probe test). nil when the bracket
  does not straddle."
  ([force-n] (mass-at-force-kg force-n 1.0e-5 10.0 50))
  ([force-n lo hi iters]
   (let [ok? #(>= (force-at %) force-n)]
     (when (and (not (ok? lo)) (ok? hi))
       (loop [lo lo hi hi i 0]
         (if (>= i iters)
           hi
           (let [mid (/ (+ lo hi) 2.0)]
             (if (ok? mid) (recur lo mid (inc i)) (recur mid hi (inc i))))))))))

(defn- mass-window [product-class]
  (let [{:keys [min max]} (robotics/seating-force-band-for product-class)]
    {:band-n {:min min :max max}
     :min-mass-kg (mass-at-force-kg min)
     :max-mass-kg (mass-at-force-kg max)}))

(defn probe []
  (let [runs (mapv run-one sweep)
        numeric? (fn [r] (number? (get-in r [:quantities :sim-peak-seating-force-n])))]
    {:physics-probe/schema schema
     :repo "cloud-itonami/cloud-itonami-isic-2670"
     :procedure "Lens-barrel press-fit seating-force verification (robot lens-seating cell)"
     :solver "physics-2d/world-step"
     :runs runs
     :derived {:consumer-grade-mass-window (mass-window :consumer-grade)
               :ruggedized-grade-mass-window (mass-window :ruggedized-grade)}
     :count (count (filter numeric? runs))
     :expected (count sweep)}))

(defn -main [& _]
  (let [p (probe)]
    (prn p)
    (when-not (= (:count p) (:expected p))
      #?(:cljs (set! (.-exitCode js/process) 2)
         :default (System/exit 2)))))
